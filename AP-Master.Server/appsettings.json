{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Development/Data/telegroup.db"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": true
  },
  "AI": {
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "Model": "openrouter/free",
    "TimeoutSeconds": 30,
    "MaxTokens": 800,
    "MaxHistoryMessages": 20,
    "MaxHistoryCharacters": 12000,
    "MaxConcurrentRequests": 4,
    "QueueTimeoutSeconds": 10,
    "DummyLatencyMilliseconds": 0
  },
  "RateLimiting": {
    "Enabled": true,
    "Api": { "TokenLimit": 120, "TokensPerPeriod": 60, "PeriodSeconds": 30 },
    "Chat": { "TokenLimit": 15, "TokensPerPeriod": 5, "PeriodSeconds": 20 }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:9879" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
