# Which API implementation the app talks to: mock | live
# mock = in-memory fake, no backend needed (default)
# live = real endpoints via the Vite proxy
#
# Override locally without touching this tracked file by creating
# .env.development.local (Vite gives mode-specific files precedence, so a plain
# .env.local would NOT win over this one)
VITE_API_MODE=mock
