<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings, passed to dotnet test with the settings option (see .github/workflows/ci.yml).
     Generated code (EF Core migrations, source generators) is excluded so the figure reflects
     hand-written code only. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
